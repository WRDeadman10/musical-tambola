{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Tambola",
  "version": "0.1.0",
  "identifier": "com.mediatambola.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Media Tambola",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: media: data:; media-src 'self' asset: https: media: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
