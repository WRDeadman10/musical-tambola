    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
